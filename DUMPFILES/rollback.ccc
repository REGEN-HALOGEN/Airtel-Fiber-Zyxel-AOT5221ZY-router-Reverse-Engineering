RDMNAME config;
REQUEST;
SEL InternetGatewayDevice.X_5067F0_Ext.WANSwitch;
SET WANMode string GPON;
SET_NO_BE WanAutoDetect boolean 0;
SEL InternetGatewayDevice.WANDevice.1.WANConnectionDevice.1.WANPPPConnection.1;
SET_NO_BE Enable boolean 1;
SEL InternetGatewayDevice.WANDevice.1.WANConnectionDevice.2.WANIPConnection.1;
SET_NO_BE Enable boolean 1;
SEL InternetGatewayDevice.WANDevice.1.WANConnectionDevice.3.WANIPConnection.1;
SET_NO_BE Enable boolean 1;
SEL InternetGatewayDevice.WANDevice.1.WANEthernetInterfaceConfig;
SET_NO_BE Enable boolean 1;
SEL InternetGatewayDevice.LANDevice.1.X_5067F0_IPv6LANHostConfigManagement.NDPPD;
SET_NO_BE Enabled boolean 0;
SEL InternetGatewayDevice.LANDevice.1.X_5067F0_IPv6LANHostConfigManagement.IPv6PDWanConnection;
SET_NO_BE Interface string InternetGatewayDevice.WANDevice.1.WANConnectionDevice.1.WANPPPConnection.1;
SEL InternetGatewayDevice.Layer3Forwarding;
SET_NO_BE DefaultConnectionService string InternetGatewayDevice.WANDevice.1.WANConnectionDevice.1.WANPPPConnection.1;
SEL InternetGatewayDevice.X_5067F0_IPv6Layer3Forwarding;
