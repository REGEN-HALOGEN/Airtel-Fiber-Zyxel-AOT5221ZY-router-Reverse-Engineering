#!/bin/sh

DEVICE="$1"

# EVENT is defined on file ccc_event.h
CEVENT_WAN_PPPv6_UP=213


echo "CEVENT_WAN_PPPv6_UP $DEVICE" > /dev/console
echo "PID: $DEVICE.pid" > /dev/console

if [ -f /var/wan_connection_notify/$DEVICE"_connection_v6_is_up" ]
then
	rm -rf /var/wan_connection_notify/$DEVICE"_connection_v6_is_up"
fi

touch /var/wan_connection_notify/$DEVICE"_connection_v6_is_up"
echo "RDMNAME config;" >> /var/wan_connection_notify/$DEVICE"_connection_v6_is_up"
echo "EVENTNOTIFY $CEVENT_WAN_PPPv6_UP string $DEVICE;" >> /var/wan_connection_notify/$DEVICE"_connection_v6_is_up"
ccctest -f /var/wan_connection_notify/$DEVICE"_connection_v6_is_up"
