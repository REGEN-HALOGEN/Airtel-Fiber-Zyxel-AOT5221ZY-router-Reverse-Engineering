#!/bin/sh

. /lib/functions.sh

TEST_BTN=0

if [ -f "/tmp/btn_test" ]
then
	TEST_BTN=1
fi

if [ "$ACTION" = "released" -a "$BUTTON" = "reset" ]; then
	if [ -f "/tmp/btn_test" ]
	then
		echo "[button test] press reset button" > /dev/console
	fi
	if [ $SEEN -lt 1 ]; then
		SEEN=1
	fi
	hwbtn_trigger -b RESET -a 0 -d $TEST_BTN -t $SEEN > /dev/console
fi

return 0
