#!/bin/sh /etc/rc.common

START=08

PNAME="VoIP_BSP"
DEBUG=1

W_LOG()
{
	if [ $DEBUG -eq 1 ]; then
		echo "[${PNAME}] $@" > /dev/console
	fi
}

W_ERR()
{
	if [ $DEBUG -eq 1 ]; then
		echo "[${PNAME}][ERR] $@" > /dev/console
	fi
}

start()
{
	W_LOG "Boot DSP ..."
	/etc/rc_boot_dsp &> /dev/console
}

